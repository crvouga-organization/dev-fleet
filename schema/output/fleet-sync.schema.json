{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-sync.schema.json",
  "title": "The fleet-sync report, version 3",
  "description": "What homelab converge prints with --json. A preview (--dry-run) adds plan.",
  "type": "object",
  "required": [
    "version",
    "command",
    "execution",
    "ok",
    "applied",
    "desiredRevision",
    "checks",
    "nodes",
    "candidates",
    "dashboardUrl"
  ],
  "properties": {
    "version": { "const": 3 },
    "command": { "const": "converge" },
    "execution": { "const": "manager-push" },
    "ok": { "type": "boolean" },
    "applied": { "type": "boolean" },
    "versionParity": {
      "type": "object",
      "required": ["revision", "complete", "nodes"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "complete": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "pending"],
            "properties": {
              "node": { "type": "string" },
              "pending": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "acceptance": {
      "description": "Acceptance after recording deployment and checking the fleet state.",
      "type": "object",
      "required": ["failOnWarning", "warnings", "accepted"],
      "properties": {
        "failOnWarning": { "type": "boolean" },
        "warnings": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "boolean" }
      }
    },
    "desiredRevision": { "type": ["string", "null"] },
    "selectedBy": {
      "description": "What selected the desired revision: the installed package, --revision, --rollback, the manager's schedule, the HEAD of the checkout fleet-sync was started in, or the revision already approved.",
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": {
          "enum": [
            "package",
            "revision",
            "rollback",
            "schedule",
            "checkout",
            "approved"
          ]
        },
        "handOff": {
          "description": "The run was handed to the manager by this worker, or by a machine the fleet does not declare (null).",
          "type": "object",
          "required": ["worker"],
          "properties": { "worker": { "type": ["string", "null"] } }
        },
        "allowUnmerged": {
          "description": "The run was given --allow-unmerged.",
          "const": true
        }
      }
    },
    "replacedRevision": {
      "description": "The approved revision the desired one replaces, when it is another.",
      "type": "string"
    },
    "checks": { "type": "array", "items": { "$ref": "check.schema.json" } },
    "candidates": { "type": "integer" },
    "dashboardUrl": { "type": ["string", "null"] },
    "planFingerprint": { "type": "string" },
    "canary": { "type": "string" },
    "enrolled": {
      "description": "The workers this run enrolled: added to the roster, or bound to their tailnet device.",
      "type": "array",
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "checks",
          "reachability",
          "desiredRevision",
          "appliedRevision",
          "durationMs"
        ],
        "properties": {
          "node": { "type": "string" },
          "role": { "enum": ["manager", "worker"] },
          "reachability": {
            "enum": ["online", "offline", "missing", "conflict", "unknown"]
          },
          "desiredRevision": { "type": ["string", "null"] },
          "appliedRevision": { "type": ["string", "null"] },
          "durationMs": { "type": "number" },
          "earlierChecks": {
            "type": "array",
            "items": { "$ref": "check.schema.json" }
          },
          "checks": {
            "type": "array",
            "items": { "$ref": "check.schema.json" }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["state", "revision", "known", "tools", "restarts", "nodes"],
      "properties": {
        "state": { "type": "string" },
        "known": { "type": "boolean" },
        "revision": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": ["string", "null"] },
            "to": { "type": "string" }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "from", "to"],
            "properties": {
              "tool": { "type": "string" },
              "from": { "type": ["string", "null"] },
              "to": { "type": ["string", "null"] }
            }
          }
        },
        "restarts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "reason", "endsRunningTurns"],
            "properties": {
              "service": { "type": "string" },
              "reason": { "type": "string" },
              "endsRunningTurns": { "type": "boolean" },
              "deadlineHours": { "type": "number" }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "from", "to", "changes"],
            "properties": {
              "node": { "type": "string" },
              "from": { "type": ["string", "null"] },
              "to": { "type": "string" },
              "changes": { "type": "boolean" }
            }
          }
        },
        "removals": {
          "type": "array",
          "description": "What the sync removes from a worker whose features the fleet configuration turned off since it was last applied.",
          "items": {
            "type": "object",
            "required": ["node", "removes"],
            "properties": {
              "node": { "type": "string" },
              "removes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
