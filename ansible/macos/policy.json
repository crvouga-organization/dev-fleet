{
  "version": 1,
  "minimumMajorVersion": 14,
  "architectures": ["arm64", "x86_64"],
  "pmset": {
    "sleep": "0",
    "womp": "1",
    "autorestart": "1"
  },
  "beszelDaemon": "dev.homelab.beszel-agent",
  "disk": {
    "warnFreeMiB": 20480,
    "failFreeMiB": 5120,
    "dockerWarnGiB": 64
  },
  "containerWatchdog": {
    "unhealthyChecks": 3,
    "maxRestartsPerHour": 3,
    "intervalSeconds": 60
  },
  "dockerDesktop": {
    "settings": "Library/Group Containers/group.com.docker/settings-store.json",
    "key": "AutoStart"
  },
  "fleetSync": {
    "label": "personal-fleet-sync",
    "convergenceWarnHours": 2,
    "intervalMinutes": 30
  },
  "fleetWatch": {
    "label": "dev.homelab.fleet-watch",
    "intervalMinutes": 15
  },
  "vaultRenewal": {
    "incrementHours": 48,
    "expiryWarnHours": 24
  },
  "diskGc": {
    "label": "dev.homelab.disk-gc",
    "script": ".local/share/personal/fleet/manager/disk-gc.py",
    "report": "Library/Caches/homelab/disk-gc.json",
    "cacheRoots": [".cache", "Library/Caches"]
  },
  "jobLogs": {
    "directory": ".local/share/personal/fleet/manager/logs",
    "maxKiB": 1024,
    "keep": 3
  }
}
