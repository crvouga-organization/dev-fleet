{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["deps"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The tunnel image of the monitoring hub, by tag and digest. The Beszel image moves with its agents' digests, by hand (docs/declared.md).",
      "managerFilePatterns": ["/^ansible/monitoring/lock\\.json$/"],
      "matchStrings": [
        "\"tunnelImage\": \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The self-hosted tailnet control plane of the tailnet-box scenarios, by tag and digest.",
      "managerFilePatterns": ["/^features/tailnet-box/support/lock\\.json$/"],
      "matchStrings": [
        "\"headscale\": \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Tailscale on workers: the version of the package, which is the release's number.",
      "managerFilePatterns": ["/^ansible/ubuntu/policy\\.json$/"],
      "matchStrings": [
        "\"tailscale\": \\{\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "A worker whose Tailscale is older than the pin stops with TAILSCALE_UPGRADE_PENDING, so the pin follows a release only once workers have had time to take it by themselves.",
      "matchPackageNames": ["tailscale/tailscale"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Agent CLIs are what every node runs; review each bump on its own.",
      "matchManagers": ["mise"],
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "actions"
    },
    {
      "description": "The Pins workflow locks stable provider releases across every supported platform.",
      "matchManagers": ["mise"],
      "matchPackageNames": [
        "codex",
        "claude",
        "gemini",
        "copilot",
        "aqua:anomalyco/opencode",
        "http:grok",
        "http:antigravity",
        "anomalyco/opencode",
        "openai/codex",
        "anthropics/claude-code",
        "google-gemini/gemini-cli",
        "github/copilot-cli"
      ],
      "enabled": false
    }
  ]
}
